From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Devin <158243242+devin-ai-integration[bot]@users.noreply.github.com>
Date: Sun, 15 Nov 2026 18:50:05 +0100
Subject: [PATCH] packing/shader_split: an FZLC chunk stored uncompressed is
 read as it is

The DLCs' staticshadernx.cache copies are 804-byte stubs whose single
short chunk is stored, not a zstd frame (stored length == raw length);
requiring a frame in every chunk left each stub out with a red line.
Reported by Melaylou on PR #2694; their #2430 reads the same caches and
already covers the case.

Upstream-Status: forwarded seedds/nxnative#2694
Reason: REDengine's DLC shader-cache stubs store a chunk uncompressed; the reader must not require a zstd frame there
Issue: LNPANDY/NX2Apple#1318
---
 dm/gfx/tools/shader_split.py      | 4 +++-
 dm/tools/tests/test_split_rdhs.py | 9 +++++++++
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/dm/gfx/tools/shader_split.py b/dm/gfx/tools/shader_split.py
index c326eec0..40850085 100644
--- a/dm/gfx/tools/shader_split.py
+++ b/dm/gfx/tools/shader_split.py
@@ -2285,7 +2285,9 @@ def fzlc_unchunk(d, label):
     if 8 + 12 * n > len(d): red(f'{label}: FZLC chunk table of {n} entries lies outside the file')
     for i in range(n):
         off, cs, us = struct.unpack_from('<3I', d, 8 + 12 * i)
-        if off + cs > len(d) or d[off:off + 4] != ZSTD_MAGIC: red(f'{label}: FZLC chunk {i} @{off:#x} is not a zstd frame')
+        if off + cs > len(d): red(f'{label}: FZLC chunk {i} @{off:#x} lies outside the file')
+        if cs == us: out.append(d[off:off + cs]); continue   # a chunk kept stored (the DLCs' staticshadernx.cache stubs: one short uncompressed chunk each)
+        if d[off:off + 4] != ZSTD_MAGIC: red(f'{label}: FZLC chunk {i} @{off:#x} is not a zstd frame')
         b = zstd.decompress(d[off:off + cs])
         if len(b) != us: red(f'{label}: FZLC chunk {i} is {len(b):#x} bytes, its entry says {us:#x}')
         out.append(b)
diff --git a/dm/tools/tests/test_split_rdhs.py b/dm/tools/tests/test_split_rdhs.py
index 164aa317..e74805fb 100644
--- a/dm/tools/tests/test_split_rdhs.py
+++ b/dm/tools/tests/test_split_rdhs.py
@@ -107,6 +107,15 @@ class Fzlc(unittest.TestCase):
         with self.assertRaisesRegex(SystemExit, 'not a zstd frame'):
             ss.fzlc_shaders(bytes(d), '/bad')
 
+    def test_stored_chunk(self):
+        """The DLCs' staticshadernx.cache stubs keep their one short chunk uncompressed (stored length == raw length)"""
+        payload = static_records(fz.glslc([fz.VS]))
+        d = b'FZLC' + struct.pack('<I', 1) + struct.pack('<3I', 0x14, len(payload), len(payload)) + payload
+        (rel, keys, pairs, extra), log = self.scan(d)
+        self.assertEqual(log, '')
+        self.assertEqual(len(keys), 1)
+        self.assertEqual(list(keys.values())[0][1], 'vs')
+
 
 if __name__ == '__main__':
     unittest.main()
