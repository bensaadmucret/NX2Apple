 #   · SNVN (Retro Studios, Donkey Kong Country: Tropical Freeze, Metroid Prime Remastered): zlib program records in the SNVN chunks of MaterialArchive.arc, of the MTRL resources in its
 #       .pak archives and of the startup material archive LZSS-compressed in main, see rfrm_shaders and retro_main_forms
 #   · BERG (Snowdrop, Mario + Rabbids Sparks of Hope): shader objects in the individually zstd-compressed records of its SDF data slices, see snowdrop_shaders
+#   · RDHS v3 and FZLC (REDengine, The Witcher 3): a GLSLC output in every zstd record of each content/*/shadernx.cache, and in the FZLC chunks of
+#       staticshadernx.cache, see rdhs_shaders and fzlc_shaders
 #   · bnd2 (Criterion's Bundle 2, Need for Speed: Hot Pursuit Remastered): whole GLSLC outputs in the zlib resources of SHADERS.BNDL, see bnd2_resources and bnd2_shaders
 #   · Heaps (Dead Cells): whole GLSLC outputs in base64 after the GLSL of the engine's shader cache (shaders.cache.nx), inside its PAK archive, see heaps_pak_files and heaps_shaders
 #   · Frostbite (EA SPORTS FC 27): the CompiledBytecode resources of the bundles its superbundle tables (.toc) list, in its cas files (Oodle Leviathan, decoded by the game's own decoder in the
@@ -1907,6 +1909,43 @@ def nvn_loose(d, label):
     if st is None or check(label, st, ctl, code): return []
     return [(f'{label}#NVN@{0:#x}', st, ctl, code)]
 
+def fzlc_unchunk(d, label):
+    """REDengine's chunked zstd container ('FZLC', The Witcher 3's content/content0/staticshadernx.cache): u32 chunk count, then per chunk
+    {u32 offset, u32 stored length, u32 length}, each a zstd frame → the chunks joined."""
+    zstd = zstd_mod(); out = []
+    n = field(d, '<I', 4, label)[0]
+    if 8 + 12 * n > len(d): red(f'{label}: FZLC chunk table of {n} entries lies outside the file')
+    for i in range(n):
+        off, cs, us = struct.unpack_from('<3I', d, 8 + 12 * i)
+        if off + cs > len(d) or d[off:off + 4] != ZSTD_MAGIC: red(f'{label}: FZLC chunk {i} @{off:#x} is not a zstd frame')
+        b = zstd.decompress(d[off:off + cs])
+        if len(b) != us: red(f'{label}: FZLC chunk {i} is {len(b):#x} bytes, its entry says {us:#x}')
+        out.append(b)
+    return b''.join(out)
+
+def fzlc_shaders(d, label):
+    """The GLSLC outputs an FZLC container's payload holds (The Witcher 3's staticshadernx.cache: records of {u64 hash, u64 hash, u32 length,
+    a GLSLC output} laid end to end, the length the output's own, so the joined bytes are scanned for the outputs)."""
+    return glslc_shaders(fzlc_unchunk(d, label), f'{label}#FZLC', need=False)
+
+def rdhs_shaders(d, label):
+    """REDengine's shader cache, version 3 (The Witcher 3's content/*/shadernx.cache, every content level's and DLC's own): a run of
+    {u64 hash, u8 1, u32 raw length, u32 stored length, one zstd frame holding a GLSLC output}, then the name index and a trailer
+    {u32 record count, u32, u64, u64 index offset, u64 index length, u64 index offset, 'RDHS', u32 3}. Read by the trailer's magic, the
+    index offset ending the run, as the generic prefilter sees nothing in the compressed records."""
+    if len(d) < 0x30 or d[-8:-4] != b'RDHS': return []
+    n, ioff = struct.unpack_from('<I', d, len(d) - 48)[0], struct.unpack_from('<Q', d, len(d) - 32)[0]
+    out = []; pos = 0; recs = 0; zstd = zstd_mod()
+    while pos < ioff:
+        h, t, us, cs = struct.unpack_from('<QBII', d, pos)
+        if t != 1 or pos + 17 + cs > ioff: red(f'{label}: record @{pos:#x} breaks the run')
+        raw = zstd.decompress(d[pos + 17:pos + 17 + cs])
+        if len(raw) != us: red(f'{label}: record @{pos:#x} is {len(raw):#x} bytes, its header says {us:#x}')
+        out += glslc_shaders(raw, f'{label}#RDHS@{pos:#x}'); recs += 1
+        pos += 17 + cs
+    if recs != n: red(f'{label}: the trailer names {n} records, the run holds {recs}')
+    return out
+
 def phyre_shaders(d, label):
     """Phyre's NVN code immediately precedes its control section, unaligned in RYHP effects; loose blobs also prefix their two lengths (FFX/X-2)."""
     out = []
@@ -3022,6 +3061,9 @@ def scan_file_in(args):
     if head[:4] == b'BERG':   # Snowdrop's SDF data slices: shader objects in individual compressed records
         with open(path, 'rb') as f: found += snowdrop_shaders(f.read(), '/' + rel)
         return rel, uniq_keys(found), var_pairs(found), trees
+    if head[:4] == b'FZLC':   # REDengine's chunked zstd container (The Witcher 3's staticshadernx.cache): a GLSLC store once unchunked (fzlc_shaders)
+        with open(path, 'rb') as f: found += fzlc_shaders(f.read(), '/' + rel)
+        return rel, uniq_keys(found), var_pairs(found), trees
     if head[:4] == MTARC:   # an MT Framework archive (mtarc_members): its shader package
         mtarc_shaders(open(path, 'rb').read(), '/' + rel, found)
         return rel, uniq_keys(found), var_pairs(found), trees
@@ -3069,6 +3111,7 @@ def scan_file_in(args):
         except unityfs.NoTree: return rel, {}, set(), 'defer'
         return rel, uniq_keys(found), var_pairs(found) | {(a, b, 'prog') for a, b in pairs}, trees
     elif loose := nvn_loose(d, '/' + rel): found += loose
+    elif d[-8:-4] == b'RDHS': found += rdhs_shaders(d, '/' + rel)   # REDengine's shader cache (The Witcher 3's shadernx.cache): no head magic, the GLSLC outputs in its zstd records (rdhs_shaders)
     elif b'BNSH\0\0\0\0' not in d and b'BAHS' not in d and d[:4] != b'MSHD' and d[:4] != b'NDSR' and d[:4] != b'NARC' and d[:4] != b'NDVE' and not (d[:4] == b'SARC' and b'Yaz0' in d) and b'\x91\x68\x86\x19' not in d and MGFX not in d and NEEDLE not in d and d[:8] != SUMO_MUX and SUMO_NX not in d and NVNSH not in d: return rel, {}, set(), {}   # a SARC may hold Yaz0 members, a NARC packed ones (cra.undo)
     else:
         scan_blob(d, '/' + rel, found)
diff --git a/dm/tools/tests/test_split_rdhs.py b/dm/tools/tests/test_split_rdhs.py
new file mode 100644
index 0000000..164aa31
--- /dev/null
+++ b/dm/tools/tests/test_split_rdhs.py
@@ -0,0 +1,112 @@
+"""REDengine's shader containers (The Witcher 3): the RDHS v3 caches (content/*/shadernx.cache, a run of zstd records
+{u64 hash, u8 1, u32 raw length, u32 stored length}, each holding a GLSLC output, a name index and a trailer naming it) and the
+FZLC chunked zstd of staticshadernx.cache ({u64, u64, u32 length, GLSLC output} records in the joined chunks). Synthetic bytes only."""
+import contextlib
+import io
+import struct
+import tempfile
+import unittest
+from pathlib import Path
+
+from dm.tools.tests.test_split_gzip import ss
+import dm.tools.fuzz.fuzz_shader_split as fz
+
+
+def rdhs(records, version=3):
+    """A shadernx.cache: the records ({u64 hash, u8 1, u32 raw length, u32 stored length, zstd frame} of each (hash, raw) given), the index, then the trailer"""
+    zstd = ss.zstd_mod(); out = bytearray()
+    for h, raw in records:
+        stored = zstd.compress(raw)
+        out += struct.pack('<QBII', h, 1, len(raw), len(stored)) + stored
+    ioff = len(out); out += b'index' + bytes(0x20)
+    out += struct.pack('<IIQ', len(records), 0, 0) + struct.pack('<QQ', ioff, len(out) - ioff) + struct.pack('<Q', ioff) + b'RDHS' + struct.pack('<I', version)
+    return bytes(out)
+
+
+def fzlc_file(payload, chunk=0x1000):
+    """'FZLC', u32 chunk count, per chunk {u32 offset, u32 stored length, u32 length} of a zstd frame holding a slice of the payload"""
+    zstd = ss.zstd_mod(); chunks = [(zstd.compress(payload[i:i + chunk]), min(chunk, len(payload) - i)) for i in range(0, len(payload), chunk)]
+    head = b'FZLC' + struct.pack('<I', len(chunks)); table = b''; at = 8 + 12 * len(chunks)
+    for stored, us in chunks: table += struct.pack('<3I', at, len(stored), us); at += len(stored)
+    return head + table + b''.join(c for c, _ in chunks)
+
+
+def static_records(*outputs):
+    """staticshadernx.cache's payload: {u64 hash, u64 hash, u32 length, GLSLC output} records laid end to end"""
+    return b''.join(struct.pack('<QQI', i, i + 1, len(o)) + o for i, o in enumerate(outputs)) + bytes(0x1c)
+
+
+class Rdhs(unittest.TestCase):
+    def scan(self, data, rel='shadernx.cache'):
+        with tempfile.TemporaryDirectory() as t, contextlib.redirect_stdout(io.StringIO()) as log:
+            path = Path(t) / rel; path.write_bytes(data)
+            result = ss.scan_file((str(path), rel))
+        return result, log.getvalue()
+
+    def test_records_hold_their_glslc_outputs(self):
+        d = rdhs([(0x1111, fz.glslc([fz.VS])), (0x2222, fz.glslc([fz.PS]))])
+        (rel, keys, pairs, extra), log = self.scan(d)
+        self.assertEqual(log, '')
+        self.assertEqual({v[1] for v in keys.values()}, {'vs', 'ps'})
+        self.assertEqual(len(keys), 2)
+        self.assertTrue(all('#RDHS@' in v[0] and '#GLSLC@' in v[0] for v in keys.values()))
+
+    def test_every_stage(self):
+        vs2 = fz.stage(0x0469)   # a second, distinct vertex shader
+        d = rdhs([(i, fz.glslc([s])) for i, s in enumerate((fz.VS, fz.PS, vs2))])
+        (rel, keys, pairs, extra), log = self.scan(d)
+        self.assertEqual(len(keys), 3)
+        self.assertEqual(sorted(v[1] for v in keys.values()), ['ps', 'vs', 'vs'])
+
+    def test_not_rdhs_is_untouched(self):
+        self.assertEqual(ss.rdhs_shaders(bytes(0x100), '/x'), [])
+        self.assertEqual(ss.rdhs_shaders(b'tiny', '/x'), [])
+        d = rdhs([(1, fz.glslc([fz.VS]))])
+        self.assertEqual(ss.rdhs_shaders(d[:-12] + b'NONE' + d[-4:], '/x'), [])   # no trailer magic: not read
+
+    def test_broken_run_is_named(self):
+        d = bytearray(rdhs([(1, fz.glslc([fz.VS])), (2, fz.glslc([fz.VS]))]))
+        d[8] = 9   # record 0's type byte
+        with self.assertRaisesRegex(SystemExit, 'breaks the run'):
+            ss.rdhs_shaders(bytes(d), '/bad')
+
+    def test_size_mismatch_is_named(self):
+        d = bytearray(rdhs([(1, fz.glslc([fz.VS]))]))
+        struct.pack_into('<I', d, 0x09, 1)   # the raw length no longer matches the frame's
+        with self.assertRaisesRegex(SystemExit, 'header says'):
+            ss.rdhs_shaders(bytes(d), '/bad')
+
+
+class Fzlc(unittest.TestCase):
+    def scan(self, data, rel='staticshadernx.cache'):
+        with tempfile.TemporaryDirectory() as t, contextlib.redirect_stdout(io.StringIO()) as log:
+            path = Path(t) / rel; path.write_bytes(data)
+            result = ss.scan_file((str(path), rel))
+        return result, log.getvalue()
+
+    def test_chunked_glslc_records(self):
+        d = fzlc_file(static_records(fz.glslc([fz.VS]), fz.glslc([fz.PS]), fz.glslc([fz.stage(0x0469)])))
+        (rel, keys, pairs, extra), log = self.scan(d)
+        self.assertEqual(log, '')
+        self.assertEqual(len(keys), 3)
+        self.assertEqual(sorted(v[1] for v in keys.values()), ['ps', 'vs', 'vs'])
+        self.assertTrue(all('#FZLC#GLSLC@' in v[0] for v in keys.values()))
+
+    def test_a_record_may_span_chunks(self):
+        d = fzlc_file(static_records(fz.glslc([fz.VS]), fz.glslc([fz.PS])), chunk=0x200)
+        (rel, keys, pairs, extra), log = self.scan(d)
+        self.assertEqual(len(keys), 2)
+
+    def test_bad_table_is_named(self):
+        with self.assertRaisesRegex(SystemExit, 'chunk table'):
+            ss.fzlc_shaders(b'FZLC' + struct.pack('<I', 1 << 28), '/bad')
+
+    def test_non_zstd_chunk_is_named(self):
+        d = bytearray(fzlc_file(static_records(fz.glslc([fz.VS]))))
+        struct.pack_into('<3I', d, 8, len(d) - 0x14, 0x14, 0x100)   # point the chunk at the trailer, which is not a frame
+        with self.assertRaisesRegex(SystemExit, 'not a zstd frame'):
+            ss.fzlc_shaders(bytes(d), '/bad')
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/docs/reference/shaders.md b/docs/reference/shaders.md
index 4ed185f..84a4626 100644
--- a/docs/reference/shaders.md
+++ b/docs/reference/shaders.md
@@ -266,6 +266,15 @@ Finding, keying and translating shaders (`dm/gfx/tools/shader_split.py`, `dmsh_b
 - **DLC:** additional shader records ship in the DLC's data slices. The NSP script includes each extracted DLC RomFS as an extra shader root, without an ExeFS module, and fingerprints its index and extraction timestamps for split reuse. Vulkan and OpenGL builds include the DLC roots too. When installing or removing optional DLC changes an NVN shader union, the script uses an external profile with new shader tables only after every non-DLC shader row and fact matches the registered tables; package indices may change. The registered module builds, settings and build-gated cuts are preserved. A cached proof of this comparison permits repeat builds to reuse the split.
 - **Found on:** [Mario + Rabbids Sparks of Hope](../../dm/games/0100317013770000/README.md) (zstd); [Mario + Rabbids Kingdom Battle](../../dm/games/010067300059A000/README.md) (zlib records, some wrapped in zstd chunks; shorter control sections and headerless compute code).
 
+### GLSLC outputs in REDengine's shader caches
+
+- **Symptom:** the split finds a few hundred shaders in `main` and `bin/shaders`, but the game asks for thousands of keys it does not have (`shader <key> is not in the shader map`), only a few draws land each frame and the screen stays black.
+- **Cause:** REDengine keeps its precompiled NVN shaders in its own caches, which no reader knew: `content/*/shadernx.cache` (an `RDHS` container) and `content/content0/staticshadernx.cache` (an `FZLC` chunked zstd container). Every byte inside is a compressed record, so the generic scan sees no control section and no GLSLC magic.
+- **How it is stored:** an `RDHS` v3 file is a run of `{u64 hash, u8 1, u32 raw length, u32 stored length, a zstd frame}` records, each frame one GLSLC output, then the name index and a trailer `{u32 record count, u32, u64, u64 index offset, u64 index length, u64 index offset, 'RDHS', u32 3}`. An `FZLC` file is `'FZLC'`, a u32 chunk count and per chunk `{u32 offset, u32 stored length, u32 length}` of a zstd frame; the joined payload holds `{u64 hash, u64 hash, u32 length, a GLSLC output}` records laid end to end, the length the output's own.
+- **Fix:** `shader_split.py` reads both (`rdhs_shaders` by the trailer's magic, `fzlc_shaders` by `FZLC`): each record or chunk is decompressed and read as a GLSLC output (`glslc_shaders`). The caches' programs hold one stage and take the [single-stage cover](#single-stage-programs-paired-with-a-cover).
+- **Found on:** The Witcher 3: Wild Hunt — Complete Edition (`0100E67012924000`, no profile): `shadernx.cache` holds 8,186 shaders (6,789 vertex, 1,391 pixel, 4 domain, 2 hull), `staticshadernx.cache` 619 (278 vertex, 271 pixel, 46 compute, 22 geometry, 1 hull, 1 domain), and they cover the shader keys the runtime named at startup. With `main` and `bin` the split writes 9,344 shaders where it found 539.
+- **Check:** `dm/tools/tests/test_split_rdhs.py`: synthetic caches — a record per stage, a record spanning FZLC chunks, a broken record run, a wrong raw length, a bad chunk table and a chunk that is not a frame.
+
 ### CompiledBytecode resources in Frostbite superbundles
 
 - **Symptom:** the survey finds no shader container in a RomFS of `.toc` and `.cas` files (`Data/NX`, `Patch/NX`, `Data/layout.toc`, `Data/initfs_NX`); the split reads every file loosely and finds nothing.
